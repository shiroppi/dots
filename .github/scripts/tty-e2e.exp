#!/usr/bin/expect -f
# Drive one interactive dots command through a pty.
# Usage: tty-e2e.exp <steps> <command> [args...]
#   steps: Tcl list of {pattern key} pairs (flat). For each pair, wait for the
#          regexp, pause briefly, then send the key ("\r" = Enter, "\003" =
#          Ctrl-C). After the last step, wait for the process to exit.
# Everything the program prints goes to stdout; the exit status is the
# program's own. Exit 99 means a pattern never appeared (timeout).
set timeout 30
set steps [lindex $argv 0]
set cmd [lrange $argv 1 end]

spawn -noecho {*}$cmd
# Wide pty so prompt titles do not wrap in the middle of a pattern.
catch { stty columns 200 rows 50 < $spawn_out(slave,name) }

foreach {pattern key} $steps {
    expect {
        -re $pattern {}
        timeout {
            puts "\n\[tty-e2e\] TIMEOUT waiting for /$pattern/"
            exit 99
        }
        eof {
            puts "\n\[tty-e2e\] process exited while waiting for /$pattern/"
            exit 98
        }
    }
    sleep 1
    send -- [subst -nocommands -novariables $key]
}

expect {
    eof {}
    timeout {
        puts "\n\[tty-e2e\] TIMEOUT waiting for exit"
        exit 99
    }
}
set result [wait]
lassign $result pid spawnid os_error value
# Killed by a signal: [wait] is {pid id -1 errno CHILDKILLED SIGNAME desc}.
if {[lindex $result 4] eq "CHILDKILLED"} {
    set sig [lindex $result 5]
    puts "
\[tty-e2e\] process killed by $sig"
    array set signo {SIGHUP 1 SIGINT 2 SIGQUIT 3 SIGKILL 9 SIGSEGV 11 SIGPIPE 13 SIGTERM 15}
    if {[info exists signo($sig)]} { exit [expr {128 + $signo($sig)}] }
    exit 97
}
exit $value
