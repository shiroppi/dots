# Maintainer: shiroppi
#
# Release procedure (AUR "dots-bin", repackages the GoReleaser release archives):
#   1. Wait until the GitHub Release vX.Y.Z exists (tag push -> GoReleaser).
#   2. Bump pkgver below to X.Y.Z and reset pkgrel=1.
#   3. Run `updpkgsums` (from pacman-contrib) to replace the 'SKIP'
#      placeholders with the real per-architecture sha256 sums.
#   4. Run `makepkg --printsrcinfo > .SRCINFO` and push PKGBUILD + .SRCINFO to
#      the AUR git repository.

pkgname=dots-bin
_pkgname=dots
pkgver=0.1.0
pkgrel=1
pkgdesc='A brief, declarative, flexible dotfiles manager (prebuilt binary)'
arch=('x86_64' 'aarch64' 'armv7h' 'i686' 'riscv64')
url='https://github.com/shiroppi/dots'
license=('MIT')
provides=('dots')
conflicts=('dots')

_url="$url/releases/download/v$pkgver"
source_x86_64=("$_pkgname-$pkgver-x86_64.tar.gz::$_url/${_pkgname}_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("$_pkgname-$pkgver-aarch64.tar.gz::$_url/${_pkgname}_${pkgver}_linux_arm64.tar.gz")
source_armv7h=("$_pkgname-$pkgver-armv7h.tar.gz::$_url/${_pkgname}_${pkgver}_linux_armv7.tar.gz")
source_i686=("$_pkgname-$pkgver-i686.tar.gz::$_url/${_pkgname}_${pkgver}_linux_386.tar.gz")
source_riscv64=("$_pkgname-$pkgver-riscv64.tar.gz::$_url/${_pkgname}_${pkgver}_linux_riscv64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')
sha256sums_armv7h=('SKIP')
sha256sums_i686=('SKIP')
sha256sums_riscv64=('SKIP')

# Archives hold dots, README.md and LICENSE at the top level, so makepkg
# extracts them straight into $srcdir.
package() {
  install -Dm755 dots "$pkgdir/usr/bin/dots"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
