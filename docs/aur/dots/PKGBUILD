# Maintainer: shiroppi
#
# Release procedure (AUR "dots", builds from the tagged source tarball):
#   1. Tag and push vX.Y.Z (GoReleaser publishes the GitHub Release).
#   2. Bump pkgver below to X.Y.Z and reset pkgrel=1.
#   3. Run `updpkgsums` (from pacman-contrib) to replace the 'SKIP' placeholder
#      with the real sha256 of the tag tarball.
#   4. Run `makepkg --printsrcinfo > .SRCINFO` and push PKGBUILD + .SRCINFO to
#      the AUR git repository.

pkgname=dots
pkgver=0.1.0
pkgrel=1
pkgdesc='A brief, declarative, flexible dotfiles manager'
arch=('x86_64' 'aarch64' 'armv7h' 'i686' 'riscv64')
url='https://github.com/shiroppi/dots'
license=('MIT')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::https://github.com/shiroppi/dots/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  mkdir -p build/
}

build() {
  cd "$pkgname-$pkgver"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOPATH="${srcdir}"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  # -ldflags on the command line overrides any -ldflags in GOFLAGS, so
  # -linkmode=external is repeated here next to the version stamp.
  go build \
    -ldflags "-linkmode=external -extldflags \"${LDFLAGS}\" -X main.version=${pkgver}" \
    -o build ./cmd/dots
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/dots "$pkgdir/usr/bin/dots"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
